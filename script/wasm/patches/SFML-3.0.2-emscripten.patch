# Emscripten (WebAssembly) support for the pinned SFML 3.0.2.
# Add the OS branch and compiler macros upstream lacks. Apply with:
#   patch -p1 -d SFML-3.0.2 < SFML-3.0.2-emscripten.patch

--- a/cmake/Config.cmake
+++ b/cmake/Config.cmake
@@ -60,6 +60,11 @@
 
     # use the OpenGL ES implementation on Android
     set(OPENGL_ES 1)
+elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Emscripten")
+    set(SFML_OS_EMSCRIPTEN 1)
+
+    # use the OpenGL ES implementation on Emscripten
+    set(OPENGL_ES 1)
 
 # comparing CMAKE_SYSTEM_NAME with "CYGWIN" generates a false warning depending on the CMake version
 # let's avoid it so the actual error is more visible
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -107,7 +107,7 @@
 endif()
 
 # use bundled dependencies by default on these systems and system dependencies by default on all others (maintains old behavior)
-if(SFML_OS_WINDOWS OR SFML_OS_MACOS OR SFML_OS_IOS OR SFML_OS_ANDROID)
+if(SFML_OS_WINDOWS OR SFML_OS_MACOS OR SFML_OS_IOS OR SFML_OS_ANDROID OR SFML_OS_EMSCRIPTEN)
     set(SFML_USE_SYSTEM_DEPS_DEFAULT OFF)
 else()
     set(SFML_USE_SYSTEM_DEPS_DEFAULT ON)
--- a/include/SFML/Config.hpp
+++ b/include/SFML/Config.hpp
@@ -71,7 +71,12 @@
 #elif defined(__unix__)
 
 // UNIX system, see which one it is
-#if defined(__ANDROID__)
+#if defined(__EMSCRIPTEN__)
+
+// Emscripten
+#define SFML_SYSTEM_EMSCRIPTEN
+
+#elif defined(__ANDROID__)
 
 // Android
 #define SFML_SYSTEM_ANDROID
