<!DOCTYPE html>
<html>
  <head>
    <%= erb(:headers) %>
  </head>
  <body>
    <div id="main_progress" aria-hidden="true"></div>

    <header class="project_bar">
      <a class="project_name" href="<%= url_for_index %>">sfml<span>3</span>.rb</a>
      <nav>
        <a href="https://github.com/algaves/sfml3.rb">GitHub</a>
        <a href="https://rubygems.org/gems/sfml3-rb">RubyGems</a>
        <a href="https://github.com/algaves/sfml3.rb/blob/main/CHANGELOG.md">Changelog</a>
      </nav>
    </header>

    <div class="nav_wrap">
      <iframe id="nav" src="<%= @nav_url %>?1"></iframe>
      <div id="resizer"></div>
    </div>

    <div id="main" tabindex="-1">
      <div id="header">
        <%= erb(:breadcrumb) %>
        <%= erb(:search) %>
        <div class="clear"></div>
      </div>

      <div id="content"><%= yieldall %></div>

      <%= erb(:footer) %>
    </div>
  </body>
</html>
