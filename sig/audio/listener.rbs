module SF::Audio
  module Listener
    def self.global_volume: () -> Float
    def self.global_volume=: (Float value) -> Float
    def self.position: () -> SF::System::Vector3
    def self.position=: (SF::System::Vector3 value) -> SF::System::Vector3
    def self.direction: () -> SF::System::Vector3
    def self.direction=: (SF::System::Vector3 value) -> SF::System::Vector3
    def self.velocity: () -> SF::System::Vector3
    def self.velocity=: (SF::System::Vector3 value) -> SF::System::Vector3
    def self.up_vector: () -> SF::System::Vector3
    def self.up_vector=: (SF::System::Vector3 value) -> SF::System::Vector3
    def self.cone: () -> SoundSourceCone
    def self.cone=: (SoundSourceCone value) -> SoundSourceCone
  end
end
