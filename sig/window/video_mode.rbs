module SFML
  class VideoMode
    def initialize: (Integer width, Integer height, Integer bits_per_pixel) -> void
    def self.desktop_mode: () -> VideoMode
    def self.fullscreen_modes: () -> Array[VideoMode]
    def self.[]: (Integer width, Integer height, ?Integer bits_per_pixel) -> VideoMode

    def valid?: () -> bool
    def available?: () -> bool
    def size: () -> Vector2
    def ==: (untyped other) -> bool

    attr_reader width: Integer
    attr_reader height: Integer
    attr_reader bits: Integer
  end
end
