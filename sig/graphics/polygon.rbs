module SF::Graphics
  class ConvexShape < Shape
    def initialize: (?Integer point_count) -> void
    def self.[]: (*untyped points) -> ConvexShape

    def copy: () -> ConvexShape
    def move: (SF::System::Vector2 | Array[Float] offset) -> self
    def rotate: (Float angle) -> self
    def scale!: (SF::System::Vector2 | Array[Float] factors) -> self
    def draw: (untyped target, RenderState state) -> nil

    def point_count: () -> Integer
    def point_count=: (Integer value) -> Integer
    def point: (Integer index) -> SF::System::Vector2
    def set_point: (Integer index, SF::System::Vector2 | Array[Float] point) -> SF::System::Vector2
    def position: () -> SF::System::Vector2
    def position=: (SF::System::Vector2 | Array[Float] value) -> SF::System::Vector2
    def rotation: () -> Float
    def rotation=: (Float value) -> Float
    def scale: () -> SF::System::Vector2
    def scale=: (SF::System::Vector2 | Array[Float] value) -> SF::System::Vector2
    def origin: () -> SF::System::Vector2
    def origin=: (SF::System::Vector2 | Array[Float] value) -> SF::System::Vector2
    def fill_color: () -> Color
    def fill_color=: (Color value) -> Color
    def outline_color: () -> Color
    def outline_color=: (Color value) -> Color
    def outline_thickness: () -> Float
    def outline_thickness=: (Float value) -> Float
    def texture: () -> (Texture | nil)
    def texture=: (Texture? value) -> Texture?
    def texture_rect: () -> Rect
    def texture_rect=: (Rect value) -> Rect
    def geometric_center: () -> SF::System::Vector2
    def local_bounds: () -> Rect
    def global_bounds: () -> Rect
    def transform: () -> Array[untyped]
    def inverse_transform: () -> Array[untyped]
    def matrix: () -> Array[untyped]
  end
end
